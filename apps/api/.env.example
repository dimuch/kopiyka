# Copy to .env for local dev. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# user and databases from scripts/setup-local-db.sql
DATABASE_URL=mysql://kopiyka:change-me@127.0.0.1:3306/kopiyka
# integration tests run against this database and wipe it
DATABASE_URL_TEST=mysql://kopiyka:change-me@127.0.0.1:3306/kopiyka_test

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts TOTP secrets in the DB. Production keeps its own key in the server env only.
TOTP_ENC_KEY=

SESSION_TTL_MINUTES=30
# Defaults to true when NODE_ENV=production; set false only where the API is served over plain HTTP
# COOKIE_SECURE=false

# Expo web dev server; leave empty in production (same origin)
CORS_ORIGINS=http://localhost:8081

# Notion sync (brief 020): the ledger and year whose expenses go to the Budget tables. Set both or neither.
# NOTION_LEDGER_ID=1
# NOTION_YEAR=2026
# Notion API (brief 021): create an internal integration (Read, Update and Insert content) at
# notion.so/profile/integrations, share the Budget page with it, then set both. Never commit the token.
# NOTION_TOKEN=ntn_...
# NOTION_GROCERIES_DATA_SOURCE_ID=2d2203e3-e5e5-819d-8823-000be6f1bad0
