# Copy to .env for local dev. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3200
LOG_LEVEL=info

# Where clients reach this server: an origin with no path; https in production
PUBLIC_URL=http://localhost:3200
# The kopiyka API, reached over HTTP only
API_URL=http://127.0.0.1:3000

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Seals OAuth values and access tokens. Changing it signs everyone out of the connector.
MCP_SEAL_KEY=

# The only redirects a client may register, as exact https URLs, comma-separated. Blank: no app can connect.
# Unset, this is Claude's hosted callback. Set it to add another LLM app, and keep that one.
# List only a URL whose page removes the code: curl -sI '<url>?code=x&state=y' must redirect with no code in Location.
# Claude Code can't connect directly, because a code on localhost can be talked out of a user.
# MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
