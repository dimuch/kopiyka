# Copy to .env for local dev. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3200
LOG_LEVEL=info

# Where clients reach this server: an origin with no path; https in production
PUBLIC_URL=http://localhost:3200
# The kopiyka API, reached over HTTP only
API_URL=http://127.0.0.1:3000

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Seals OAuth values and access tokens. Changing it signs everyone out of the connector.
MCP_SEAL_KEY=

# The only https redirects a client may register, as exact URLs, comma-separated. Loopback http is always allowed.
# Unset, this is the two Claude callbacks. Set it to add another LLM app, and keep those two. Blank means loopback only.
# MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
