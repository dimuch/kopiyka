# /etc/systemd/system/kopiyka.service
# Runs the kopiyka API as the `kopiyka` user on 127.0.0.1:3100. nginx
# (kopiyka.englishplus.com.ua.conf) terminates TLS, serves the web app and
# proxies /api here. Secrets live only in /etc/kopiyka/api.env (root 0600),
# which systemd reads for us; see deploy/README.md.
[Unit]
Description=Kopiyka API
After=network.target mysql.service

[Service]
Type=simple
User=kopiyka
Group=kopiyka
WorkingDirectory=/opt/kopiyka/current/apps/api
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=3100
EnvironmentFile=/etc/kopiyka/api.env
# Pending migrations run before every start. A failed migration fails the
# restart, which makes deploy.sh roll back to the previous release.
ExecStartPre=/usr/bin/node dist/scripts/migrate.js
ExecStart=/usr/bin/node dist/src/server.js
Restart=always
RestartSec=5
# Hardening. The API writes nothing to disk; logs go to journald.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# Sandbox (brief 072): what it needs is /usr/bin/node, read access to /opt/kopiyka/current (the kopiyka user's
# home, not under /home), MySQL over TCP on 127.0.0.1:3306, and ports above 1024, so no capabilities and no writes.
# A blocked system call fails with EPERM instead of killing Node, so a feature probe (libuv's io_uring) falls back.
# Left out on purpose: MemoryDenyWriteExecute (V8's JIT writes code pages), PrivateUsers and ProcSubset=pid (Node reads
# /proc/meminfo and cgroup files to size its heap).
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
# The NBU over HTTPS needs DNS; glibc's getaddrinfo with AI_ADDRCONFIG reads interfaces through AF_NETLINK. RemoveIPC
# and IPAddressDeny stay off: the kopiyka user also runs the deploy builds, and the NBU is outside.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
