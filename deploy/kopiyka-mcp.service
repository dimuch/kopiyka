# /etc/systemd/system/kopiyka-mcp.service
# Runs the MCP connector as the `kopiyka-mcp` user on 127.0.0.1:3200. nginx
# (kopiyka.englishplus.com.ua.conf) terminates TLS and proxies /mcp and /oauth
# here. It reaches kopiyka only through the API. Its seal key lives only in
# /etc/kopiyka/mcp.env (root 0600); see deploy/README.md.
[Unit]
Description=Kopiyka MCP connector
After=network.target kopiyka.service

[Service]
Type=simple
User=kopiyka-mcp
Group=kopiyka-mcp
WorkingDirectory=/opt/kopiyka/current/apps/mcp
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=3200 API_URL=http://127.0.0.1:3100
EnvironmentFile=/etc/kopiyka/mcp.env
ExecStart=/usr/bin/node dist/src/server.js
Restart=always
RestartSec=5
# Hardening. It writes nothing to disk; logs go to journald.
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
# Sandbox (brief 072): what it needs is /usr/bin/node, read access to /opt/kopiyka/current (not under /home), the API
# on 127.0.0.1:3100, and ports above 1024, so no capabilities and no writes.
# A blocked system call fails with EPERM instead of killing Node, so a feature probe (libuv's io_uring) falls back.
# Left out on purpose: MemoryDenyWriteExecute (V8's JIT writes code pages), PrivateUsers and ProcSubset=pid (Node reads
# /proc/meminfo and cgroup files to size its heap).
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# It talks only to the API and to nginx, both on loopback (apps/mcp/src/api.ts is its only fetch).
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
